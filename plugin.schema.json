{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://game-hall.local/schemas/game-plugin-v1.json",
  "title": "Game Hall community game plugin",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "version",
    "author",
    "license",
    "id",
    "name",
    "description",
    "category",
    "tone",
    "players",
    "capabilities",
    "records"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "apiVersion": { "const": 1 },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "author": { "type": "string", "minLength": 1, "maxLength": 80 },
    "license": { "type": "string", "minLength": 1, "maxLength": 32 },
    "id": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^plugin-[a-z0-9][a-z0-9-]{0,24}$"
    },
    "name": { "type": "string", "minLength": 1, "maxLength": 24 },
    "description": { "type": "string", "minLength": 1, "maxLength": 80 },
    "category": { "type": "string", "minLength": 1, "maxLength": 16 },
    "tone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 24,
      "pattern": "^[a-z0-9][a-z0-9-]{0,23}$"
    },
    "roomLayout": {
      "type": "string",
      "enum": ["standard", "wide", "immersive"]
    },
    "players": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 20 },
        "max": { "type": "integer", "minimum": 1, "maximum": 20 },
        "label": { "type": "string", "minLength": 1, "maxLength": 16 }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "guests",
        "spectators",
        "spectatorFrames",
        "firstPlayer",
        "undoActions",
        "drawRequests",
        "replay",
        "ai"
      ],
      "properties": {
        "guests": { "type": "boolean" },
        "spectators": { "type": "boolean" },
        "spectatorFrames": { "type": "boolean" },
        "firstPlayer": { "type": "boolean" },
        "undoActions": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "drawRequests": { "type": "boolean" },
        "replay": { "type": "boolean" },
        "ai": { "type": "boolean" }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoreKind"],
      "properties": {
        "scoreKind": {
          "type": "string",
          "enum": ["outcome", "time_trial", "high_score"]
        }
      }
    },
    "defaultOptions": { "type": "object" },
    "ruleLabels": {
      "type": "array",
      "maxItems": 6,
      "items": { "type": "string", "minLength": 1, "maxLength": 24 }
    }
  }
}
